{
  "name": "dsh-daily-news-digest",
  "version": "0.1.0",
  "private": false,
  "description": "Daily News Digest — a left-sidebar page that turns your topics and sources into a per-topic top-news digest, ranked by how many sources reported each story and how widely it was read.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjy201176/dsh-daily-news-digest.git"
  },
  "homepage": "https://github.com/wjy201176/dsh-daily-news-digest#readme",
  "bugs": {
    "url": "https://github.com/wjy201176/dsh-daily-news-digest/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "news",
    "digest",
    "news-aggregator",
    "rss-alternative",
    "search"
  ],
  "author": "wjy201176",
  "license": "MIT"
}
